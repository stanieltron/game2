<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Industrial smelter · minimum factory</title>
<style>
:root{color-scheme:dark;font:15px 'Segoe UI',sans-serif;background:#0c121b;color:#e4edf8}*{box-sizing:border-box}body{margin:0}main{max-width:1240px;margin:auto;padding:30px}h1{font-size:30px;margin:8px 0}h2{font-size:20px;margin:0 0 15px}p{color:#a6b8cc;line-height:1.5;margin:8px 0 18px}small{color:#94a9bf}.eyebrow{color:#6bddbc;text-transform:uppercase;letter-spacing:2px;font-size:11px}.controls{display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin:20px 0}select,input{background:#1a2738;color:#eee;border:1px solid #40546b;border-radius:5px;padding:8px}input[type=number]{width:65px}label{font-size:13px}.layout{display:grid;grid-template-columns:1.5fr 1fr;gap:24px}.card{border:1px solid #304055;border-radius:10px;padding:20px;background:#131d2a;margin-bottom:18px}.tree{list-style:none;padding-left:21px;border-left:1px solid #40556a;margin:12px 0 0 8px}.tree>li{position:relative;padding:0 0 18px 10px}.tree>li:before{content:'';position:absolute;width:22px;border-top:1px solid #40556a;left:-22px;top:12px}.tree>li:last-child{padding-bottom:0}.row{display:flex;justify-content:space-between;gap:10px;align-items:baseline}.rate{color:#6bddbc;white-space:nowrap;font-size:13px}.warm{color:#edbf78}.detail{font-size:13px;color:#a6b8cc;margin-top:5px;line-height:1.6}table{width:100%;border-collapse:collapse;font-size:13px}td,th{text-align:left;padding:9px 4px;border-bottom:1px solid #2b3b4e}td:not(:first-child),th:not(:first-child){text-align:right}th{font-size:11px;color:#a6b8cc;font-weight:500}tfoot{color:#f1c17a}.metric{font-size:24px;font-weight:600}.bar{height:6px;background:#29384b;border-radius:4px;margin:6px 0 15px;overflow:hidden}.fill{height:100%;background:#69cdb5}.fill.hot{background:#e7ae65}.end{border-color:#bc955b;background:#29251f}.note{font-size:12px;color:#9eb1c9}.check{padding:12px;border-left:3px solid #6bddbc;background:#152d2b}summary{cursor:pointer;color:#adc1d9}details{margin-top:12px}@media(max-width:800px){main{padding:16px}.layout{grid-template-columns:1fr}.row{flex-wrap:wrap}}
</style>
<main><header><div class="eyebrow">Minimum factory / first upgrade</div><h1>Build one Industrial Smelter</h1><p>One shared smelter. One shared workshop. Required materials, machine workload and power.</p><div class="controls"><label>Balance <select id="profile"><option value="live">Live game</option><option value="experimental">Experimental balance</option></select></label><label><input type="checkbox" id="research" checked> Include research</label><label><input type="checkbox" id="powerBill" checked> Include coal mine + generator build cost</label><label>Belt tiles <input id="belts" type="number" min="0" max="200" value="0"></label></div><p class="note" id="assumptions"></p></header><div id="content"></div></main>
<script>
const DATA=__DATA__, $=id=>document.getElementById(id),f=n=>Number(n.toFixed(2)).toLocaleString('en-US'),mins=s=>f(s/60)+' min';
function render(){
const c=DATA.profiles[$('profile').value],b=Object.fromEntries(c.buildings.map(x=>[x.id,x])),items=Object.fromEntries(c.items.map(x=>[x.id,x.name])),t=c.techs[0],end=b.industrialSmelter;
const belts=Math.max(0,Math.min(200,Math.floor(Number($('belts').value)||0))),research=$('research').checked,powerBill=$('powerBill').checked;
// Fuel support is sized for the installed starter line plus research and belts.
// Silicate mining is only needed when this profile's bills contain refractory.
const provisional=[...end.cost,...(research?t.cost:[]),...(powerBill?[...b.miner.cost,...b.generator.cost]:[])];
const hasSilicate=provisional.some(s=>s.item==='refractory'&&s.amount>0),materialMines=hasSilicate?3:2;
const baseLoad=materialMines*b.miner.power+b.smelter.power+b.workshop.power+belts*b.belt.power;
let generators=baseLoad+(research?t.power:0)>b.core.generation?1:0,fuelMines=generators?1:0;
for(let i=0;i<20;i++){const nextG=Math.max(0,Math.ceil((baseLoad+fuelMines*b.miner.power+(research?t.power:0)-b.core.generation)/b.generator.generation));const nextM=Math.ceil(nextG*b.generator.fuelRate/b.miner.rate);if(nextG===generators&&nextM===fuelMines)break;generators=nextG;fuelMines=nextM;}
const costs={},add=(ss,count=1)=>ss.forEach(s=>costs[s.item]=(costs[s.item]||0)+s.amount*count);add(end.cost);if(research)add(t.cost);if(powerBill){add(b.miner.cost,fuelMines);add(b.generator.cost,generators);}if(belts)add(b.belt.cost,belts);
const work=[],feed={},raw={};let workshopTime=0,smeltTime=0;
for(const [id,amount] of Object.entries(costs)){if(!amount)continue;const r=c.recipes.find(r=>r.family==='workshop'&&r.outputs.some(o=>o.item===id));if(!r)throw new Error('Unsupported starter material '+id);const output=r.outputs.find(o=>o.item===id).amount,batches=Math.ceil(amount/output),seconds=batches*r.seconds;workshopTime+=seconds;work.push({id,amount,produced:batches*output,seconds,rate:60*output/r.seconds});r.inputs.forEach(s=>feed[s.item]=(feed[s.item]||0)+s.amount*batches);}
const smelt=[];for(const [id,amount] of Object.entries(feed)){const r=c.recipes.find(r=>r.family==='smelter'&&r.outputs.some(o=>o.item===id));if(r){const batches=Math.ceil(amount/r.outputs.find(o=>o.item===id).amount),seconds=batches*r.seconds;smeltTime+=seconds;smelt.push({id,amount,seconds,rate:60*r.outputs.find(o=>o.item===id).amount/r.seconds});r.inputs.forEach(s=>raw[s.item]=(raw[s.item]||0)+s.amount*batches);}else raw[id]=(raw[id]||0)+amount;}
const names=['iron','copperOre','silicate'].filter(id=>raw[id]>0),load=baseLoad+fuelMines*b.miner.power,capacity=b.core.generation+generators*b.generator.generation,peak=load+(research?t.power:0);
const stations=[...names.map(id=>({name:items[id]+' mine',seconds:raw[id]/b.miner.rate*60})),{name:'Shared primitive smelter',seconds:smeltTime},{name:'Shared universal workshop',seconds:workshopTime}].sort((a,b)=>b.seconds-a.seconds),bound=stations[0].seconds;
const bill=ss=>'<table><tbody>'+ss.map(s=>`<tr><td>${items[s.item]}</td><td>${f(s.amount)}</td></tr>`).join('')+'</tbody></table>';
const machine=(title,power,body)=>`<li><div class="row"><strong>${title}</strong><span class="rate">${f(power)} PU</span></div><div class="detail">${body}</div></li>`;
$('assumptions').textContent='Start: material mines, primitive smelter, workshop and Command Core already built; zero stock. '+(research?'Research still needed. ':'Research already complete. ')+'End: one industrial smelter constructed. Manual transfers; no placement time. '+(belts?'Belt materials and power included; routing not simulated.':'0 belts means manual transfers, not a free automated network.');
$('content').innerHTML=`<div class="layout"><section><div class="card"><h2>Start · minimum simultaneous production line</h2><small>Machine counts → capacity → assigned work</small><ul class="tree">${names.map(id=>machine('1 × '+items[id]+' mine',b.miner.power,`<span class="rate">${f(b.miner.rate)} ${items[id]}/min</span> · ${f(raw[id])} required → ${mins(raw[id]/b.miner.rate*60)} mining work`)).join('')}${machine('1 × '+b.smelter.name,b.smelter.power,smelt.map(s=>`${items[s.id]}: ${f(s.rate)}/min · ${f(s.amount)} required · ${mins(s.seconds)}`).join('<br>')+`<br><strong>${mins(smeltTime)} total shared-machine work.</strong> Switch between iron and copper.`)}${machine('1 × '+b.workshop.name,b.workshop.power,`Makes ${work.map(s=>items[s.id]).join(', ')}.<br><strong>${mins(workshopTime)} total shared-machine work.</strong> One recipe at a time.`)}<li><div class="row"><strong>Power supply</strong><span class="rate">${f(capacity)} PU capacity</span></div><ul class="tree">${machine('Command Core',0,`${b.core.generation} PU generation; no emergency Core crafting during this calculation.`)}${generators?machine(fuelMines+' × Carbon mine',fuelMines*b.miner.power,`${f(fuelMines*b.miner.rate)} Carbon/min capacity; generators consume ${f(generators*b.generator.fuelRate)} Carbon/min.`)+machine(generators+' × '+b.generator.name,0,`${f(generators*b.generator.generation)} PU generation. Fuel continuously with Carbon.`):'<li>Core power covers this line.</li>'}</ul></li></ul><p class="note">Minimum for this conventional line with all machines enabled together. Power cycling, drone mining and emergency Core crafting can use fewer buildings, with different waiting times.</p></div><div class="card"><h2>Workshop queue · one shared machine</h2><table><thead><tr><th>Product</th><th>Needed</th><th>Alone / min</th><th>Busy time</th></tr></thead><tbody>${work.map(s=>`<tr><td>${items[s.id]}${s.produced>s.amount?'<br><small>'+f(s.produced-s.amount)+' batch surplus</small>':''}</td><td>${f(s.amount)}</td><td>${f(s.rate)}</td><td>${mins(s.seconds)}</td></tr>`).join('')}</tbody><tfoot><tr><td colspan="3">Total workshop time</td><td>${mins(workshopTime)}</td></tr></tfoot></table><p class="note">These rates cannot be added: all recipes compete for the same machine.</p></div><div class="card end"><div class="eyebrow">End · 1 completed machine</div><h2>Industrial Smelter</h2>${bill(end.cost)}<p>${mins(end.seconds)} construction · ${end.power} PU when enabled.</p><p class="note">Requires ${t.name}. ${research?'Its materials are included; research itself takes '+t.seconds+'s.':'Research assumed complete.'} This new machine cannot help make its own build materials.</p></div></section><aside><div class="card"><h2>Where you wait</h2><div class="metric warm">${stations[0].name}</div><p>Largest production workload in this configuration.</p>${stations.map(s=>`<div class="row"><small>${s.name}</small><strong>${mins(s.seconds)}</strong></div><div class="bar"><div class="fill ${s.seconds===bound?'hot':''}" style="width:${100*s.seconds/bound}%"></div></div>`).join('')}<p class="check"><strong>At least ${mins(bound)} for resource production.</strong><br>Machines can work in parallel. Do not add these bars.</p><p class="note">Workload lower bound, not exact elapsed time. Startup, recipe order, research gating, fuel and construction add waits. Doubling one machine only halves its own workload.</p></div><div class="card"><h2>Power budget</h2><table><tr><td>${materialMines} material mines</td><td>${f(materialMines*b.miner.power)} PU</td></tr><tr><td>Smelter + workshop</td><td>${f(b.smelter.power+b.workshop.power)} PU</td></tr><tr><td>${fuelMines} Carbon mine(s)</td><td>${f(fuelMines*b.miner.power)} PU</td></tr><tr><td>${belts} belt tiles</td><td>${f(belts*b.belt.power)} PU</td></tr><tr><td>Running factory</td><td>${f(load)} PU</td></tr><tr><td>Research extra</td><td>${research?t.power:0} PU</td></tr><tr><td>Peak before upgrade</td><td>${f(peak)} / ${f(capacity)} PU</td></tr><tr><td>After replacing basic smelter</td><td>${f(load-b.smelter.power+end.power)} PU</td></tr></table><p class="note">Enabled machines draw power even when waiting for input. Insufficient power stops normal production.</p></div><div class="card"><h2>Combined material bill</h2><small>Target ${research?'+ research':''} ${powerBill?'+ power equipment':''} ${belts?'+ belts':''}</small>${bill(Object.entries(costs).filter(([,n])=>n).map(([item,amount])=>({item,amount})))}${research?'<details><summary>Research bill</summary>'+bill(t.cost)+'</details>':''}<details><summary>Power equipment build bill</summary>${bill([...b.miner.cost.map(s=>({...s,amount:s.amount*fuelMines})),...b.generator.cost.map(s=>({...s,amount:s.amount*generators}))])}</details><p class="note">${powerBill?'Power equipment materials are charged; these workload totals do not simulate the startup order for building and fueling it.':'Power equipment and startup fuel are assumed available.'} Initial material mines, smelter and workshop prices excluded. Carbon is an ongoing expense; total fuel depends on elapsed time.</p></div><p class="note">Source: ${$('profile').value==='live'?'live catalog.json':'experimental fine.catalog.json; not applied to the game'}. Deterministic bill and workload calculation; not a build-order simulation.</p></aside></div>`;
}
['profile','research','powerBill','belts'].forEach(id=>$(id).onchange=render);$('belts').oninput=render;render();
</script></html>

<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Fighter · production & technology tree</title>
<style>
:root{color-scheme:dark;font-family:Inter,Segoe UI,sans-serif;background:#0b1018;color:#e0e9f5}*{box-sizing:border-box}body{margin:0}header{padding:22px 28px 16px;border-bottom:1px solid #2b3747;background:#111925}h1{font-size:26px;margin:5px 0 8px;letter-spacing:-.7px}p{color:#99abc2;line-height:1.5;font-size:13px}header p{margin:0}.eyebrow{color:#65d9bf;font-size:11px;letter-spacing:2px;text-transform:uppercase}nav{display:flex;gap:9px;align-items:center;padding:12px 28px;border-bottom:1px solid #2b3747;flex-wrap:wrap}button,select,input{background:#182333;border:1px solid #34465d;color:#e0e9f5;padding:9px 12px;border-radius:6px;font:inherit;font-size:12px}button{cursor:pointer}button:hover{border-color:#65d9bf}input{width:200px}main{display:grid;grid-template-columns:minmax(0,1fr) 340px;height:calc(100vh - 177px)}#viewport{overflow:auto;position:relative;background:radial-gradient(#213044 1px,transparent 1px);background-size:24px 24px}svg{display:block;min-width:780px}aside{overflow:auto;padding:22px;background:#111925;border-left:1px solid #2b3747}aside h2{font-size:22px;margin:8px 0 16px}h3{font-size:13px;color:#65d9bf;margin:23px 0 10px}ul{padding-left:17px;font-size:13px;line-height:1.8}table{width:100%;border-collapse:collapse;font-size:12px}td{padding:7px 0;border-bottom:1px solid #253245}td:last-child{text-align:right}small{color:#99abc2} .chip{font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#e4b967}.node{cursor:pointer;outline:none}.node rect{fill:#162334;stroke:#3b5068;stroke-width:1.5}.node:hover rect,.node:focus rect,.node.selected rect{stroke:#fff;stroke-width:2.5}.node text{fill:#e3edf8;font-size:13px;pointer-events:none}.node .sub{fill:#96adc5;font-size:10px}.node.raw rect{fill:#18362e;stroke:#439b82}.node.research rect{fill:#302741;stroke:#9d7cc8}.node.building rect{fill:#252c33;stroke:#78838e}.node.project rect{fill:#3c3020;stroke:#dfb16b}.edge{fill:none;stroke:#537087;stroke-width:1.2;opacity:.26}.edge.unlock{stroke:#ac84d8;stroke-dasharray:5 5;opacity:.3}.edge.hot{stroke:#65e4c3;stroke-width:2.5;opacity:1}.node.endpoint rect{fill:#3c3020;stroke:#dfb16b;stroke-width:2.5}.node.intermediate rect{fill:#162334;stroke:#3b5068}.node.dim{opacity:.23}.label{fill:#7d94ad;font-size:11px;letter-spacing:2px}.legend{margin-left:auto;color:#98abc3;font-size:11px}.key{display:inline-block;width:9px;height:9px;border-radius:2px;margin:0 5px 0 12px;background:#65d9bf}.key.r{background:#b596e3}.key.p{background:#dfb16b}.recipe{border:1px solid #2c3e52;border-radius:6px;padding:12px;margin:10px 0;font-size:12px;line-height:1.6}.recipe button{margin-top:8px;padding:5px 8px}.note{padding:10px;border-left:2px solid #d5a75e;background:#27251f}.phase{margin:15px 0}.phase strong{font-size:13px}.phase small{display:block;margin:5px 0}#profileNote{font-size:11px;color:#d9ba7d}@media(max-width:900px){main{grid-template-columns:minmax(0,1fr) 285px}header{padding:16px}nav{padding:10px}.legend{display:none}}@media(max-width:600px){main{display:block;height:auto}#viewport{height:65vh}aside{height:50vh;border-top:1px solid #34465d}}
</style>
<header><div class="eyebrow">Factory planner / dependency atlas</div><h1>From raw ore to a constructed Fighter</h1><p>Follow the material flow down. Select a part, research stage, or machine to inspect exact costs and dependencies.</p></header>
<nav><select id="profile" aria-label="Balance profile"><option value="live">Live game values</option><option value="experimental">Experimental balance</option></select><input id="search" aria-label="Find node" placeholder="Find a part or machine…" list="names"><datalist id="names"></datalist><button id="reset">Clear selection</button><label for="target">Build target</label><select id="target"><option value="fighter">Fighter</option><option value="bay">Fighter Bay</option><option value="b_smelter">Basic smelter</option><option value="b_industrialSmelter">Industrial smelter</option></select><button id="endpoint">Go to target ↓</button><span class="legend"><i class="key"></i>Materials<i class="key r"></i>Research<i class="key p"></i>Projects</span></nav>
<main><div id="viewport"><svg id="tree" role="group" aria-label="Fighter technology and material dependency tree"></svg></div><aside id="details"></aside></main>
<script>
const DATA=__DATA__;
let C,items,recipes,nodes,allNodes,edges,selected=null;
const $=id=>document.getElementById(id),esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),num=n=>Number(n.toFixed(2)),name=id=>items[id]?.name||id;
const bill=a=>'<table>'+a.map(s=>`<tr><td>${esc(name(s.item))}</td><td>${num(s.amount)}</td></tr>`).join('')+'</table>';
const total=ph=>{let d={};ph.forEach(p=>p.cost.forEach(s=>d[s.item]=(d[s.item]||0)+s.amount));return Object.entries(d).map(([item,amount])=>({item,amount}));};
const producers=r=>C.buildings.filter(b=>b.family===r.family);
function init(){
 C=DATA.profiles[$('profile').value];items=Object.fromEntries(C.items.map(i=>[i.id,i]));recipes=C.recipes.filter(r=>r.family!=='core');nodes=[];edges=[];selected=null;
 const required=new Set(['iron','copperOre','carbon','silicate']);
 function add(id){if(required.has(id))return;required.add(id);let r=recipes.find(r=>r.outputs.some(o=>o.item===id));if(r)r.inputs.forEach(s=>add(s.item));}
 [...total(DATA.phases.Bay),...total(DATA.phases.Fighter),...C.techs.flatMap(t=>t.cost),...C.buildings.flatMap(b=>b.cost)].forEach(s=>add(s.item));
 const levels={};function level(id){if(levels[id]!==undefined)return levels[id];let r=recipes.find(r=>r.outputs.some(o=>o.item===id));return levels[id]=r?1+Math.max(...r.inputs.map(s=>level(s.item))):0;}
 const groups={};[...required].forEach(id=>(groups[level(id)]??=[]).push(id));
 Object.entries(groups).forEach(([l,ids])=>ids.forEach((id,i)=>{let rs=recipes.filter(r=>r.outputs.some(o=>o.item===id)),tech=rs.length?Math.min(...rs.map(r=>Math.max(r.tech,Math.min(...producers(r).map(b=>b.tech))))):0;
 nodes.push({id,name:name(id),type:+l===0?'raw':'part',x:250+i*(930/ids.length),y:65+(+l)*150,w:Math.min(175,930/ids.length-10),h:66,tech,rs});
 if(rs.length)rs[0].inputs.forEach(s=>edges.push({a:s.item,b:id}));if(tech)edges.push({a:'t'+tech,b:id,unlock:true});}));
 C.techs.forEach((t,i)=>{nodes.push({id:'t'+t.id,name:t.name,type:'research',x:18,y:215+i*225,w:205,h:72,data:t});if(i)edges.push({a:'t'+C.techs[i-1].id,b:'t'+t.id,unlock:true});t.cost.forEach(s=>edges.push({a:s.item,b:'t'+t.id,detail:true}));});
 C.buildings.filter(b=>b.id!=='fighterPad').forEach((b,i)=>{nodes.push({id:'b_'+b.id,name:b.name,type:'building',x:1205,y:65+i*83,w:215,h:65,data:b});if(b.tech)edges.push({a:'t'+b.tech,b:'b_'+b.id,unlock:true});b.cost.forEach(s=>edges.push({a:s.item,b:'b_'+b.id,detail:true}));});
 const bottom=65+(Math.max(...Object.values(levels))+1)*150;
 ['Bay','Fighter'].forEach((key,i)=>{let id=key==='Bay'?'bay':'fighter';nodes.push({id,name:key==='Bay'?'Fighter Bay · commissioned':'Fighter Mk1 · constructed',type:'project',x:540,y:bottom+i*155,w:290,h:78,ph:DATA.phases[key]});total(DATA.phases[key]).forEach(s=>edges.push({a:s.item,b:id}));});
 edges.push({a:'t4',b:'bay',unlock:true},{a:'bay',b:'fighter'});
 $('tree').setAttribute('viewBox',`0 0 1440 ${Math.max(bottom+350,1700)}`);$('tree').style.width='100%';
 filterTarget();$('names').innerHTML=nodes.map(n=>`<option value="${esc(n.name)}">`).join('');render();select($('target').value);
}
function filterTarget(){
 allNodes=[...nodes];const target=$('target').value,keep=new Set();
 function visit(id){if(keep.has(id))return;keep.add(id);edges.filter(e=>e.b===id).forEach(e=>visit(e.a));}visit(target);
 nodes=nodes.filter(n=>keep.has(n.id));edges=edges.filter(e=>keep.has(e.a)&&keep.has(e.b)).map(e=>({...e,detail:false}));
 const parts=nodes.filter(n=>n.type==='raw'||n.type==='part'),rows={};parts.forEach(n=>(rows[n.y]??=[]).push(n));
 Object.values(rows).forEach(row=>row.forEach((n,i)=>{n.x=250+i*(930/row.length);n.w=Math.min(205,930/row.length-12);}));
 let y=Math.max(65,...parts.map(n=>n.y))+150;
 const bay=nodes.find(n=>n.id==='bay');if(bay&&target==='fighter'){bay.y=y;bay.intermediate=true;y+=155;}
 const end=nodes.find(n=>n.id===target);end.x=530;end.y=y;end.w=300;end.endpoint=true;
 $('tree').setAttribute('viewBox',`0 0 1200 ${Math.max(y+130,...nodes.map(n=>n.y+n.h+40))}`);
 document.querySelector('h1').textContent='Build target: '+end.name;
 $('tree').setAttribute('aria-label',end.name+' dependency tree');$('viewport').scrollTop=0;
}
function render(){
 const map=Object.fromEntries(nodes.map(n=>[n.id,n])),hot=new Set();
 function upstream(id){if(hot.has(id))return;hot.add(id);edges.filter(e=>e.b===id&&(!e.detail||id===selected)).forEach(e=>upstream(e.a));}if(selected)upstream(selected);
 let out='<defs><marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="#7e9fb5"/></marker></defs><text class="label" x="18" y="32">RESEARCH UNLOCKS</text><text class="label" x="250" y="32">MATERIAL FLOW / INPUTS → OUTPUTS</text>';
 for(const e of edges){const a=map[e.a],b=map[e.b];if(!a||!b)continue;const active=hot.has(e.a)&&hot.has(e.b);if((e.detail||e.unlock)&&!active&&!(e.a.startsWith('t')&&e.b.startsWith('t')))continue;let x1=a.x+a.w/2,y1=a.y+a.h,x2=b.x+b.w/2,y2=b.y;out+=`<path class="edge ${e.unlock?'unlock':''} ${active?'hot':''}" d="M${x1},${y1} C${x1},${(y1+y2)/2} ${x2},${(y1+y2)/2} ${x2},${y2}" marker-end="url(#arrow)"/>`;}
 for(const n of nodes){let title=n.name.replace('Megaproject','').replace('Universal Workshop S','Universal Workshop').replace('Assembler S','Assembler').replace('Fabricator S','Fabricator');let words=title.split(' '),lines=[''];words.forEach(w=>{let i=lines.length-1;if((lines[i]+w).length>Math.floor(n.w/7))lines.push(w+' ');else lines[i]+=w+' ';});let sub=n.type==='raw'?'Basic / Industrial Miner':n.type==='research'?`${n.data.seconds}s · ${n.data.power} PU`:n.type==='building'?`T${n.data.tech} · ${n.data.generation? '+'+n.data.generation:n.data.power} PU`:n.type==='project'?`${num(n.ph.reduce((a,p)=>a+p.seconds,0)/60)} min phase work`:`${n.tech?'Research '+n.tech:'Available at start'} · ${[...new Set(n.rs.map(r=>r.family))].join(' / ')}`;
 out+=`<g class="node ${n.type} ${n.endpoint?"endpoint":""} ${n.intermediate?"intermediate":""} ${selected===n.id?'selected':''} ${selected&&!hot.has(n.id)?'dim':''}" tabindex="0" role="button" aria-label="${esc(n.name)}" data-id="${n.id}"><rect x="${n.x}" y="${n.y}" width="${n.w}" height="${n.h}" rx="8"/>${lines.slice(0,2).map((s,i)=>`<text x="${n.x+10}" y="${n.y+21+i*15}">${esc(s)}</text>`).join('')}<text class="sub" x="${n.x+10}" y="${n.y+n.h-10}">${esc(sub.length>n.w/5?sub.slice(0,Math.floor(n.w/5)-1)+'…':sub)}</text></g>`;}
 $('tree').innerHTML=out;document.querySelectorAll('.node').forEach(el=>{el.onclick=()=>select(el.dataset.id);el.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();select(el.dataset.id);}};});
}
function showIntro(){$('details').innerHTML=`<div class="chip">One destination, many investments</div><h2>Build the Bay.<br>Then build the Fighter.</h2><p>Green inputs start at the top. Material arrows lead to the two gold projects at the bottom. Purple nodes are sequential research stages.</p><h3>Read the tree</h3><p>Select any node to trace its upstream requirements. Machine cards on the right show construction prices, power and unlocks. A recipe can have several producer options.</p><p class="note">Factory size and available power determine waiting time. The times here describe individual recipes and project phases.</p><h3>Time & power</h3><p>Recipe times are per batch. Project times are phase work only, excluding resource production, delivery and power waits. PU means game power units.</p><h3>Scope</h3><p>Construction ends with Fighter Mk1. Sortie fuel and ammunition are not part of this goal. Logistics and power equipment are included as support options.</p>${sourceNote()}`;}
function sourceNote(){return `<h3>Source</h3><p id="profileNote">${$('profile').value==='live'?'Live catalog.json + FactoryMegaproject.cs.':'Experimental fine.catalog.json + live project phases. Not applied to the game. Some silica building/research costs were removed in this experiment.'}</p>`;}
function select(id,jump=false){selected=id;const n=allNodes.find(n=>n.id===id);if(!n)return;render();let h=`<div class="chip">${n.type}</div><h2>${esc(n.name)}</h2>`;
 if(n.type==='project'){h+=`<p class="note">${id==='bay'?'Requires Research 4 and an available construction drone (the starting drones can do this).':'Requires a completed Fighter Bay.'} Phase power below replaces the Bay’s idle demand; it is not added to it.</p><h3>Total direct parts</h3>${bill(total(n.ph))}<h3>Ordered construction phases</h3>`;n.ph.forEach((p,i)=>h+=`<div class="phase"><strong>${i+1}. ${esc(p.name)}</strong><small>${p.seconds}s · ${p.power} PU</small>${p.cost.length?bill(p.cost):'<p>No additional parts.</p>'}</div>`);h+=`<p>${num(n.ph.reduce((a,p)=>a+p.seconds,0)/60)} minutes of phase work, once supplied and fully powered. This is not total elapsed progression time.</p>`;}
 else if(n.type==='research'){const t=n.data;h+=`<p>${t.id===1?'Available from start':'Requires Research '+(t.id-1)} · ${t.seconds}s · ${t.power} PU</p><h3>Research bill</h3>${bill(t.cost)}<h3>Building unlocks</h3>`+C.buildings.filter(b=>b.tech===t.id).map(b=>`<p>${esc(b.name)}</p>`).join('')+'<h3>New recipes</h3><p>'+[...new Set(recipes.filter(r=>r.tech===t.id).flatMap(r=>r.outputs.map(s=>name(s.item))))].map(esc).join(', ')+'</p>';}
 else if(n.type==='building'){let b=n.data;h+=`<p>${b.tech?'Requires Research '+b.tech:'Available at start'} · ${b.seconds}s construction</p><h3>Build cost</h3>${b.cost.length?bill(b.cost):'<p>No construction materials listed.</p>'}<h3>Power & throughput</h3><p>${b.generation?'Generates '+b.generation+' PU · '+b.fuelRate+' Carbon/min':b.power+' PU demand'}${b.family==='miner'?'<br>Extraction: '+b.rate+' units/min':''}</p>`;if(['belt','splitter'].includes(b.family))h+='<p>Transport rate parameter: '+b.rate+'. Actual delivery also depends on belt layout and routing.</p>';let rs=recipes.filter(r=>r.family===b.family);if(rs.length)h+='<h3>Recipes</h3>'+rs.map(recipe).join('');if(b.id==='fighterPad')h+='<p>See the gold Fighter Bay project for its phased construction bill.</p>';}
 else if(n.type==='raw'){h+='<p>Extracted by a Basic Miner or Industrial Miner on the corresponding deposit.</p>';if(n.id==='carbon')h+='<p>Carbon fuels generators. It is an ongoing power expense, separate from project material bills.</p>';h+=C.buildings.filter(b=>b.family==='miner').map(b=>`<div class="recipe">${esc(b.name)} · ${b.rate}/min · ${b.power} PU<br><button data-select="b_${b.id}">Inspect miner</button></div>`).join('');}
 else {h+='<h3>Production options</h3>'+n.rs.map(recipe).join('');}
 $('details').innerHTML=h+sourceNote();$('details').scrollTop=0;document.querySelectorAll('[data-select]').forEach(b=>b.onclick=()=>select(b.dataset.select));if(jump){const el=document.querySelector(`[data-id="${id}"]`);el?.scrollIntoView({block:'center',behavior:'instant'});}}
function recipe(r){return `<div class="recipe"><strong>${esc(r.name)}</strong><br>${r.inputs.map(s=>s.amount+' '+esc(name(s.item))).join(' + ')}<br>→ ${r.outputs.map(s=>s.amount+' '+esc(name(s.item))).join(' + ')}<br>${num(r.seconds)}s / batch · recipe T${r.tech}<br>${producers(r).map(b=>`${esc(b.name)} · ${b.power} PU · T${b.tech}<br><button data-select="b_${b.id}">Machine cost</button>`).join('<br>')}</div>`;}
 const zoom=document.createElement('button');zoom.textContent='Fit whole tree';zoom.id='zoom';$('reset').after(zoom);let overview=false;zoom.onclick=()=>{overview=!overview;const svg=$('tree');svg.style.minWidth=overview?'0':'780px';svg.style.width=overview?Math.min($('viewport').clientWidth,($('viewport').clientHeight-15)*svg.viewBox.baseVal.width/svg.viewBox.baseVal.height)+'px':'100%';zoom.textContent=overview?'Readable size':'Fit whole tree';};
 $('profile').onchange=()=>{overview=false;zoom.textContent='Fit whole tree';$('tree').style.minWidth='780px';init();};$('reset').onclick=()=>select($('target').value);$('target').onchange=$('profile').onchange;$('endpoint').onclick=()=>select($('target').value,true);$('search').onchange=()=>{let q=$('search').value.toLowerCase(),n=nodes.find(n=>n.name.toLowerCase()===q)||nodes.find(n=>n.name.toLowerCase().includes(q));if(n)select(n.id,true);};init();
</script></html>
